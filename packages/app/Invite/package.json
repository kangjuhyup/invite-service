{
  "name": "Invite",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "setup:env:local": "doppler secrets download --config dev --no-file --format env > .env",
    "setup:env:dev": "doppler secrets download --config prd --no-file --format env > .env",
    "android:local": "yarn setup:env:local && react-native run-android",
    "ios:local": "yarn setup:env:local && react-native run-ios",
    "ios:dev": "yarn setup:env:dev && react-native run-ios",
    "ios:beta": "yarn setup:env:dev && cd ios && fastlane beta",
    "android:beta": "yarn setup:env:dev && cd android && fastlane beta",
    "lint": "eslint .",
    "start": "react-native start",
    "debug": "open -a 'React Native Debugger'",
    "test": "jest"
  },
  "dependencies": {
    "@dotlottie/react-player": "^1.6.19",
    "@miblanchard/react-native-slider": "^2.6.0",
    "@react-native-async-storage/async-storage": "^2.1.1",
    "@react-native-community/datetimepicker": "^8.3.0",
    "@react-native-community/slider": "^4.5.5",
    "@react-native-firebase/app": "^21.10.0",
    "@react-native-firebase/messaging": "^21.10.0",
    "@react-native-google-signin/google-signin": "^13.1.0",
    "@react-native/gradle-plugin": "^0.78.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/elements": "^2.2.5",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@react-navigation/stack": "^7.1.1",
    "lottie-react-native": "^7.2.2",
    "react": "19.0.0",
    "react-native": "0.78.0",
    "react-native-canvas": "^0.1.40",
    "react-native-dotenv": "^3.4.11",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.23.1",
    "react-native-image-crop-picker": "^0.42.0",
    "react-native-image-picker": "^8.0.0",
    "react-native-modal": "^13.0.1",
    "react-native-reanimated": "^3.16.7",
    "react-native-safe-area-context": "^5.2.0",
    "react-native-screens": "^4.6.0",
    "react-native-share": "^12.0.7",
    "react-native-vector-icons": "^10.2.0",
    "react-native-view-shot": "^4.0.3",
    "react-native-webview": "^13.13.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^15.1.3",
    "@react-native-community/cli-platform-android": "^15.1.3",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.78.0",
    "@react-native/eslint-config": "0.78.0",
    "@react-native/metro-config": "0.78.0",
    "@react-native/typescript-config": "0.78.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^18.2.6",
    "@types/react-native-canvas": "^0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^18.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "18.3.1",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
